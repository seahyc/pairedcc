{
  "name": "pairedcc",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter server dev & pnpm --filter web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev:canvas": "pnpm --filter @pairedcc/canvas dev",
    "build:canvas": "pnpm --filter @pairedcc/canvas build",
    "test:canvas": "pnpm --filter @pairedcc/canvas test",
    "eval:canvas": "pnpm --filter @pairedcc/canvas eval",
    "mcp:canvas": "pnpm --filter @pairedcc/canvas mcp"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-view": "1.42.9",
      "prosemirror-model": "1.25.13",
      "prosemirror-state": "1.4.4"
    }
  }
}
