DATABASE_URL=postgres://pairedcc:pairedcc_dev@localhost:5432/pairedcc
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_URL=
BASE_URL=http://localhost:3000

# 32-byte hex key for AES-256-GCM encryption of connector credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_ENCRYPTION_KEY=

# Public browser SDK license; required to render the hosted thinking canvas.
VITE_TLDRAW_LICENSE_KEY=

# Resident canvas agent (optional). The secret the agent presents (openssl rand -hex 32)
# and the accounts whose asks it answers: account ids or sign-in emails, comma separated.
# Leave the secret empty to keep the channel off.
CANVAS_RESIDENT_SECRET=
CANVAS_RESIDENT_ALLOW=
